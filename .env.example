# ─────────────────────────────────────────────────────────────
#  CONFIGURATION DU BOT FXT — TruckersMP Status
#  Copie ce fichier en ".env" et remplis les valeurs
# ─────────────────────────────────────────────────────────────

# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=METS_TON_TOKEN_ICI

# ID du channel où le message de statut (épinglé) sera affiché
# Ex: #tmp-statut
STATUS_CHANNEL_ID=0

# ID du channel où les alertes de panne seront postées
# Ex: #tmp-alertes  (peut être le même que STATUS_CHANNEL_ID)
ALERT_CHANNEL_ID=0

# Intervalle de vérification en minutes (défaut: 5)
CHECK_INTERVAL=5

# ── BOT CLASSEMENT TRUCKSBOOK ──────────────────────────────

# ID du channel où le classement sera affiché (ex: #tb-classement-fr)
RANKING_CHANNEL_ID=0

# Nombre d'entreprises à afficher dans le top (défaut: 15)
RANKING_TOP=15

# Intervalle de mise à jour en minutes (défaut: 60)
# TrucksBook ne se met pas à jour en temps réel, 60 min est largement suffisant
RANKING_INTERVAL=60
